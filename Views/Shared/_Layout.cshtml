@inject AppDb db
@{ var org = db.Org.FirstOrDefault(); }
<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>@org?.Name</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container">
  <a class="navbar-brand" asp-controller="Home" asp-action="Index">
    @if (org?.LogoPath != null) { <img src="@org.LogoPath" height="28" class="me-2" /> }@org?.Name</a>
  @if (User.Identity!.IsAuthenticated) {
  <ul class="navbar-nav me-auto">
    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Books</a></li>
    @if (User.IsInRole("Member")) { <li class="nav-item"><a class="nav-link" asp-controller="Circulation" asp-action="MyBooks">My Books</a></li> }
    @if (User.IsInRole("Admin") || User.IsInRole("Librarian")) {
      <li class="nav-item"><a class="nav-link" asp-controller="Circulation" asp-action="Issue">Issue</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Circulation" asp-action="Active">Return / Delays</a></li>
      <li class="nav-item"><a class="nav-link" asp-controller="Circulation" asp-action="History">History</a></li> }
    @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Org">Organization</a></li> }
  </ul>
  <a class="nav-link text-white me-3" asp-controller="Profile" asp-action="Me">@User.Identity.Name</a>
  <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Logout</button></form> }
</div></nav>
<main class="container py-4">@RenderBody()</main>
<footer class="text-center text-muted small py-4">Powered by Md. Atikur Rahman Mridha</footer></body></html>
