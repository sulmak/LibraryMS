<h3>Add book</h3><form method="post" class="col-md-5">
<input name="Title" class="form-control mb-2" placeholder="Title" required><input name="Author" class="form-control mb-2" placeholder="Author" required>
<input name="ISBN" class="form-control mb-2" placeholder="ISBN"><input name="Category" class="form-control mb-2" placeholder="Category">
<input name="TotalCopies" type="number" min="1" value="1" class="form-control mb-2"><button class="btn btn-primary">Save</button></form>
