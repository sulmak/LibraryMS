<div class="col-md-4 mx-auto card card-body"><h4>Register</h4>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
<form method="post"><input name="fullName" class="form-control mb-2" placeholder="Full name" required>
<input name="email" type="email" class="form-control mb-2" placeholder="Email" required>
<input name="password" type="password" class="form-control mb-2" placeholder="Password (min 6, upper, lower, digit)" required>
<button class="btn btn-success w-100">Register</button></form></div>
