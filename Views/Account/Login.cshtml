<div class="col-md-4 mx-auto card card-body"><h4>Login</h4>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
<form method="post"><input name="email" type="email" class="form-control mb-2" placeholder="Email" required>
<input name="password" type="password" class="form-control mb-2" placeholder="Password" required>
<label class="mb-2"><input type="checkbox" name="remember" value="true"> Remember me</label>
<button class="btn btn-primary w-100">Login</button></form>
<a asp-action="Register" class="mt-2">Create member account</a></div>
